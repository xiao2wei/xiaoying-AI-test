  {
    "id": "STAB-TEST17-R1",
    "category": "conflict",
    "family": "appeal_region",
    "mode": "single",
    "turns": [
      {
        "question": "校内申诉处理决定仍有异议，要向哪个上级机关书面申诉？正文与附表的说法是否可靠一致？",
        "history_mode": "independent",
        "expected_status": "needs_confirmation",
        "required_points": [
          "正文写学校上一级主管机关",
          "附3写浙江省教育厅",
          "定位两处差异或异常",
          "不能擅自确认浙江或改写为辽宁",
          "请工会或申诉委员会核实"
        ],
        "evidence_units": [
          [
            "D24-C022"
          ],
          [
            "D24-C029"
          ]
        ],
        "evidence": [
          {
            "chunk_id": "D24-C022",
            "doc_id": "D24",
            "title": "辽宁科技大学教职工校内申诉处理暂行办法（修订）",
            "article": "第二十一条",
            "version_date": "2021-05-30",
            "pdf_pages": [
              185
            ],
            "printed_pages": [
              180
            ],
            "text": "第二十一条 申诉处理决定是学校对教职工处分或处理的最终决定。申诉处理\n决定书一经送达申诉双方当事人，立即生效。被申诉人应当执行学校教职工校内申\n诉处理委员会的申诉处理决定；教职工如对申诉处理决定仍有异议的，可以向学校的\n上一级主管机关提出书面申诉。\n申诉处理决定书的送达，依照民事诉讼法关于送达的规定执行。"
          },
          {
