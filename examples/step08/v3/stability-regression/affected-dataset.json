    "mode": "single",
    "turns": [
      {
        "question": "仅按2023请假补充规定，病假累计超过6个月，工作年限满10年与不满10年时，岗位工资、薪级工资和基础绩效按什么比例发？",
        "history_mode": "independent",
        "expected_status": "answered",
        "required_points": [
          "满10年按80%",
          "不满10年按70%",
          "比例针对岗位工资薪级工资基础绩效，不能泛化所有收入"
        ],
        "evidence_units": [
          [
            "D20-C009"
          ]
        ],
        "evidence": [
          {
            "chunk_id": "D20-C009",
            "doc_id": "D20",
            "title": "辽宁科技大学教职工考勤与请假管理补充规定",
            "article": "第八条",
            "version_date": "2023-12-27",
            "pdf_pages": [
              173
            ],
            "printed_pages": [
              168
            ],
            "text": "第八条 教职工因病经三甲级以上医院诊断不能正常上班，可请病假。每次病\n假申请时间以医生提出建议休息天数为准，具体要求及待遇如下：\n请假时间≤2个月的由所在单位审批，报人事处备案。请假时间大于2个月的经所\n在单位同意后，报主管校领导批准、人事处备案。病假连续≥6个月，可申请长期病休\n手续，长期病休人员需每半年到三甲级以上医院进行一次复查，由医院出具不能工作\n诊断证明，继续办理请假手续。长期病休人员如恢复工作，需由三甲级以上医院证明\n确已康复，办理销假手续，正式返岗工作。病假相关待遇见下表。\n全年累计请假时间 | 相关待遇\n＞5日，≤60日 | 奖励绩效按请假实际天数扣发\n＞60日，≤6个月 | 工作年限满10年的发岗位工资、薪级工资和基础绩效，工作年限不满10年的发岗位工资、薪级工资和基础绩效的90%。\n＞6个月 | 工作年限满10年的发岗位工资、薪级工资和基础绩效的80%；工作年限不满10年的发岗位工资、薪级工资和基础绩效的70%。\n被认定为工伤，接受工伤医疗期间 | 不作病假处理，工伤医疗期按《工伤保险条例》等国家相关文件规定执行。"
          }
        ],
        "answerable": true,
        "search_evaluable": true,
        "read_evaluable": true,
        "allowed_actions": [
          "search",
          "read",
          "query_rewrite",
          "ask_confirmation",
          "stop_with_truthful_status"
        ],
        "forbidden": [
          "编造资料中的制度事实",
