      "question": "从事特种作业的临时用工人员有什么额外资格要求？",
      "history": [],
      "output": {
        "status": "answered",
        "claims": [
          {
            "text": "从事特种作业的临时用工人员，必须经过专门培训并获得特种作业资格。",
            "citations": [
              {
                "chunk_id": "D23-C013",
